{
	"name": "obsidian-heatmap-bases-view",
	"version": "2.0.0",
	"private": true,
	"description": "Obsidian plugin that adds a GitHub-contributions-style heatmap view to Bases.",
	"keywords": [
		"obsidian",
		"obsidian-md",
		"obsidian-plugin",
		"bases",
		"heatmap"
	],
	"homepage": "https://github.com/kitschpatrol/obsidian-heatmap-bases-view",
	"bugs": "https://github.com/kitschpatrol/obsidian-heatmap-bases-view/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/obsidian-heatmap-bases-view.git"
	},
	"license": "0BSD",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"contributors": [
		{
			"name": "Peter Peirce",
			"url": "https://github.com/ppeirce"
		}
	],
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"build": "tsc --noEmit --skipLibCheck && pnpm build:bundle",
		"build:bundle": "shx rm -rf ./dist && tsx ./scripts/build.ts production",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "shx rm -rf ./dist && tsx ./scripts/build.ts",
		"fix": "ksc fix",
		"heatmap-bases-view:deploy-local": "shx mkdir -p ~/Notes/Vault/.obsidian/plugins/heatmap-bases-view && shx cp -r ./dist/* ~/Notes/Vault/.obsidian/plugins/heatmap-bases-view",
		"lint": "ksc lint",
		"manifest": "tsx ./scripts/generate-manifest.ts",
		"release": "pnpm manifest && bumpp package.json manifest.json --commit 'Release: %s' --tag '%s' --all --execute 'chagent'",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@kitschpatrol/chagent": "0.4.0",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@types/node": "~24.13.6",
		"@vitest/coverage-v8": "^3.2.4",
		"bumpp": "^12.3.0",
		"chokidar": "^6.0.0",
		"esbuild": "^0.28.2",
		"jsdom": "^27.4.0",
		"obsidian": "1.14.4",
		"shx": "^0.4.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"obsidian": {
		"author": "Kitschpatrol",
		"description": "A GitHub-contributions-style heatmap view for Bases. Visualize boolean or numeric properties from daily notes over time.",
		"id": "heatmap-bases-view",
		"isDesktopOnly": false,
		"minAppVersion": "1.15.0",
		"name": "Heatmap Bases View"
	}
}
